{
  "id": "dankDisplayMirror",
  "name": "Screen Mirroring",
  "description": "Route multiple Wayland display mirrors from the DankMaterialShell Control Center",
  "version": "0.3.0",
  "license": "MIT",
  "author": "sherlockholmese",
  "type": "composite",
  "capabilities": [
    "control-center",
    "daemon"
  ],
  "components": {
    "widget": "./ScreenMirrorWidget.qml",
    "daemon": "./ScreenMirrorDaemon.qml"
  },
  "settings": "./ScreenMirrorSettings.qml",
  "startupCheck": "./StartupCheck.qml",
  "icon": "screen_share",
  "requires_dms": ">=2.0.0",
  "dependencies": [
    "wl-mirror",
    "dms"
  ],
  "permissions": [
    "settings_read",
    "settings_write",
    "process"
  ]
}
